# ============================================================================
# GIANT PROMOTIONS OS — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env.local for local development or paste into Railway Variables
# ============================================================================

# 1. PostgreSQL Database (Railway provides this automatically in production;
#    leave blank locally to use the built-in persisted PGlite database in .data/pgdata)
DATABASE_URL=

# 2. Public App URL (used for OAuth callbacks and customer quote approval links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 3. Google Workspace Authentication (@giantpro.ca & @giantpro.com)
ALLOWED_GOOGLE_DOMAINS=giantpro.ca,giantpro.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# 4. Sage Business Cloud Accounting API (Master Invoice Numbering 232016+)
SAGE_CLIENT_ID=
SAGE_CLIENT_SECRET=
SAGE_REDIRECT_URI=http://localhost:3000/api/sage/callback

# 5. Google Drive Folder Sync (Optional — creates "Invoice 232016" folders automatically)
GOOGLE_DRIVE_PARENT_FOLDER_ID=
